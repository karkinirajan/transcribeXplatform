{
  "name": "transcribe",
  "version": "1.0.0",
  "description": "Audio & Video Transcription Desktop App",
  "main": "main.js",
  "author": {
    "name": "Nirajan Karki",
    "email": "karkinirajan1999@gmail.com"
  },
  "homepage": "https://github.com/karkinirajan/transcribe",
  "license": "MIT",
  "scripts": {
    "dev": "concurrently -n api,next,electron -c magenta,cyan,yellow \"npm run dev:api\" \"npm run dev:next\" \"wait-on http://127.0.0.1:3000 && electron .\"",
    "dev:api": "uv run --project .. python ../backend/main.py",
    "dev:next": "cd ../frontend && npm run dev",
    "assemble:runtime": "uv run --project .. ../scripts/bundle_runtime.py",
    "assemble:ffmpeg": "uv run --project .. ../scripts/fetch_ffmpeg.py",
    "assemble:frontend": "node ../scripts/build_frontend.mjs",
    "assemble": "npm run assemble:runtime && npm run assemble:ffmpeg && npm run assemble:frontend",
    "pack": "electron-builder --dir",
    "build": "npm run assemble && electron-builder",
    "dist:mac": "npm run assemble && electron-builder --mac",
    "dist:win": "npm run assemble && electron-builder --win",
    "dist:linux": "npm run assemble && electron-builder --linux"
  },
  "devDependencies": {
    "concurrently": "^8.2.0",
    "electron": "^35.0.0",
    "electron-builder": "^25.0.0",
    "wait-on": "^8.0.0"
  }
}
