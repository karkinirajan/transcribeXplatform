# ── AssemblyAI ──────────────────────────────────────────────────────────────
# Free $50 credits on sign-up (no card required) → https://assemblyai.com
# Features: speaker diarization, name detection, 99+ languages
ASSEMBLYAI_API_KEY=

# ── Deepgram ────────────────────────────────────────────────────────────────
# Free tier: 12 000 min/yr (no card required) → https://deepgram.com
# Features: speaker diarization, Nova-3 model, 40+ languages
DEEPGRAM_API_KEY=

# ── OpenAI ──────────────────────────────────────────────────────────────────
# Pay-per-use, no free tier → https://platform.openai.com
# Models: gpt-4o-transcribe ($0.006/min), gpt-4o-mini-transcribe ($0.003/min)
#
# This key also powers the "Summarize" button on finished transcripts.
OPENAI_API_KEY=

# Model used for summaries. Defaults to gpt-4o-mini — cheap and fast.
# SUMMARY_MODEL=gpt-4o-mini

# ── Whisper (Local) ─────────────────────────────────────────────────────────
# No API key needed. Install with: uv sync --extra whisper
# Completely free, runs offline on your machine.
